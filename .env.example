# Environment variables for ForgeOrbit.
#
# Day-to-day development does not need any of these — defaults are fine.
# Copy this file to `.env` only if you need to override something (custom
# data dir, alternate agent binaries) or you're running the release pipeline
# locally as a maintainer.
# Both FORGEORBIT_* and legacy AGETOR_* prefixes are supported.

# ─── Runtime overrides (optional) ─────────────────────────────────────────
# Override the bound port for the local HTTP API (default: 4317).
# FORGEORBIT_API_PORT=4317
# AGETOR_API_PORT=4317

# Where the SQLite db, worktrees, and logs live. macOS default:
# ~/Library/Application Support/ForgeOrbit. Linux: $XDG_DATA_HOME/forgeorbit
# (or ~/.local/share/forgeorbit). Windows: %LOCALAPPDATA%/ForgeOrbit.
# FORGEORBIT_DATA_DIR wins over explicit legacy AGETOR_DATA_DIR.
# No automatic discovery/import of ~/.agetor. Set an override deliberately
# to keep using an existing profile. Dev scripts explicitly use ~/.agetor-dev.
# FORGEORBIT_DATA_DIR=
# AGETOR_DATA_DIR=

# Per-agent binary + arg overrides. Useful for testing against a different
# CLI install, or for substituting `/bin/echo` in tests.
# AGETOR_CLAUDE_BIN=
# AGETOR_CLAUDE_ARGS=
# AGETOR_CODEX_BIN=
# AGETOR_CODEX_ARGS=
# FORGEORBIT_TMUX_BIN=
# AGETOR_TMUX_BIN=

# Bypass tmux + the real claude CLI entirely (test-only).
# AGETOR_CLAUDE_DRIVER=fake

# ─── Local release preparation (Owner only) ──────────────────────────────
# Local signing/notarization credentials for `bun run release`.
# GitHub Actions/CI/CD are not used. Do NOT commit real values.

# Apple Developer ID Application certificate identity, e.g.:
#   "Developer ID Application: Your Company (TEAMID123)"
# ELECTROBUN_DEVELOPER_ID=

# App Store Connect API key for notarization.
# ELECTROBUN_APPLEAPIKEY=          # key id (10 chars)
# ELECTROBUN_APPLEAPIISSUER=       # issuer uuid
# ELECTROBUN_APPLEAPIKEYPATH=      # absolute path to AuthKey_XXXX.p8

# Password used when exporting the Developer ID .p12 cert.
# DEVELOPER_ID_CERT_PASSWORD=

# Publication is a separate manual Owner action; local builds need no GitHub token.

# Updater stays off until a separately verified production rollout.
# Explicit opt-in only; FORGEORBIT_DISABLE_UPDATES / AGETOR_DISABLE_UPDATES=1 wins.
# FORGEORBIT_ENABLE_UPDATES=1
